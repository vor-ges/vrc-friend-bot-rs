# discordのbotのtoken
DISCORD_TOKEN=

# botを稼働させるサーバーのID
GUILD_ID=

# コマンドを受け付けるメインチャンネルのID
MAIN_CHANNEL_ID=

# DiscordユーザーID（メンション先・コマンド実行者）
OWNER_ID=

# VRChatアカウントユーザーネーム・パスワード
VRC_USERNAME=
VRC_PASSWORD=

# VRChatのAPI規約に従い連絡先を入れる
VRC_USER_AGENT=VRCFriendBot/1.0 your-email@example.com

# ---- Rust版だけの設定 (任意。詳しくは RUNNING.md の 6.) ----
# BOT_DB=bot-rs.db
# STATS_DB=/絶対パス/bot.db
# STATS_MODE=readonly
# FRIEND_CATEGORY=VRC-Friends-rs
# FRIEND_CATEGORY_ID=
